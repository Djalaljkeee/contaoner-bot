# --- Telegram ---
BOT_TOKEN=put-your-bot-token-here

# id группового чата менеджеров (бот должен быть добавлен с правами писать)
MANAGERS_CHAT_ID=-1000000000000

# Telegram user_id менеджеров через запятую — могут жать "Взять в работу"
ADMIN_IDS=

# --- База данных ---
# Локально (без Docker) — SQLite по умолчанию:
# DB_URL=sqlite+aiosqlite:///./data/bot.db
#
# В Docker compose DB_URL подставляется автоматически из POSTGRES_*.
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=konteiner24

# --- Контактные данные КОНТЕЙНЕР 24 ---
COMPANY_NAME=КОНТЕЙНЕР 24
COMPANY_PHONE=+7 966 888-12-22
COMPANY_PHONE2=+7 965 555-33-66
COMPANY_EMAIL=petrix.fin@mail.ru
COMPANY_SITE=https://konteiner24.ru
COMPANY_ADDRESS_BASE=Москва, ул. Котляковская, 6 (база отгрузки)
COMPANY_ADDRESS_OFFICE=Москва, Каширское шоссе, 61 к3а (офис)

# --- Калькулятор ---
# Тариф доставки (₽/км от Москвы). Менять здесь — без участия разработчика.
DELIVERY_RATE_PER_KM=55

# --- Docker image (опционально) ---
# BOT_IMAGE_TAG=v1.0.0
