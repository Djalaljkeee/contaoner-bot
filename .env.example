# --- Telegram ---
BOT_TOKEN=put-your-bot-token-here

# id группового чата менеджеров (бот должен быть туда добавлен)
MANAGERS_CHAT_ID=-1000000000000

# Telegram user_id тех, кому разрешено жать "Взять в работу" (через запятую)
ADMIN_IDS=

# --- База данных ---
# Локально (без Docker) можно оставить SQLite по умолчанию:
# DB_URL=sqlite+aiosqlite:///./data/bot.db
#
# В Docker compose DB_URL подставляется автоматически из POSTGRES_*.
# Параметры Postgres-контейнера:
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=containers

# --- Контактные данные компании (для блока "Контакты") ---
COMPANY_PHONE=+7 985 888-58-86
COMPANY_EMAIL=9858885886@mail.ru
COMPANY_SITE=https://из-контейнеров.рф

# --- Docker image (опционально) ---
# По умолчанию compose тянет ghcr.io/djalaljkeee/contaoner-bot:latest.
# Чтобы зафиксировать версию — раскомментировать и указать тег:
# BOT_IMAGE_TAG=v1.0.0
