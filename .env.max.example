# Токен MAX-бота — получить после регистрации на business.max.ru
MAX_BOT_TOKEN=your_max_bot_token_here

# chat_id менеджера в MAX (для уведомлений о заявках)
# Узнать можно написав боту — он логирует chat_id входящих сообщений
MANAGER_CHAT_ID=0

# База данных (SQLite по умолчанию, для прода заменить на PostgreSQL)
DB_URL=sqlite+aiosqlite:///./data/max_bot.db
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/max_bot

# Данные компании (менять при необходимости)
COMPANY_NAME=Петрикс-Хоум / КОНТЕЙНЕР 24
COMPANY_PHONE=8 (966) 888-12-22
COMPANY_PHONE2=8 (965) 555-33-66
COMPANY_EMAIL=Petrix.fin@mail.ru
